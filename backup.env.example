# Nama alias yang telah dibuat menggunakan: mc alias set
MINIO_ALIAS=minio-local

# Bucket akan dibuat otomatis jika belum tersedia.
MINIO_BUCKET=backup-maria-db

# Gunakan path absolut agar aman saat dijalankan oleh cron.
BACKUP_DIR=/path/to/sqldump-backup-minio/backups

# 1 = simpan .sql.gz lokal setelah upload sukses, 0 = hapus.
KEEP_LOCAL_BACKUP=0

# Format lama (semua container pakai user/password yang sama):
# BACKUP_TARGETS="mariadb-server-1:app-1:all-databases mariadb-server-2:app-2:all-databases"
#
# Format baru (setiap container bisa punya user/password berbeda):
# BACKUP_TARGETS="mariadb-server-1:app-1:all-databases:backup_user_1:pass1 mariadb-server-2:app-2:all-databases:backup_user_2:pass2"
#
# Jika hanya ingin memakai user/password global, cukup isi variabel MARIADB_USER dan MARIADB_PASSWORD.
MARIADB_USER=root
MARIADB_PASSWORD=rootpassword
BACKUP_TARGETS="mariadb-server-1:app-1:all-databases mariadb-server-2:app-2:all-databases"
