# Ganti seluruh nilai CHANGE_ME sebelum menjalankan MinIO.
MINIO_ROOT_USER=CHANGE_ME_ACCESS_KEY
MINIO_ROOT_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# 127.0.0.1 hanya mengizinkan akses dari host MinIO.
# Gunakan IP LAN atau 0.0.0.0 bila server database lain perlu mengakses MinIO.
MINIO_BIND_IP=127.0.0.1
MINIO_SERVER_PORT=9110
MINIO_BROWSER_PORT=9111
